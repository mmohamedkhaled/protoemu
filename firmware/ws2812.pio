; WS2812 ("NeoPixel") LED driver: an example of a protocol that is not built
; into the chip in any way and is added purely by loading this program.
;
; Tick rate: 10 x the bit rate (8 MHz for the usual 800 kbit/s).
; Pins:      SIDE_BASE = data out.
; Host:      one pixel per TX FIFO word: 24 bits of colour (G, R, B) in bits
;            31:8.
;
; A 0 bit is high for T1 ticks, a 1 bit for T1 + T2 ticks, of T1 + T2 + T3.

.program ws2812
.side_set 1
.config autopull 1
.config pull_thresh 24

.define T1 3
.define T2 3
.define T3 4

bitloop:
    out x, 1         side 0 [T3 - 1]
    jmp !x do_zero   side 1 [T1 - 1]
    jmp bitloop      side 1 [T2 - 1]
do_zero:
    nop              side 0 [T2 - 1]
