# Clock/data discipline of the SPI, JTAG and SWD programs on the real state
# machine: data changes only while the clock is low. Unbounded proof.

[tasks]
spi
jtag
swd

[options]
mode prove
depth 12

[engines]
smtbmc yices

[script]
spi: read_verilog -formal -DFORMAL -DFW_SPI pe_sm.v pe_shift.v pe_decoder.v spi_master_sm.v fw_clock_data.v
jtag: read_verilog -formal -DFORMAL -DFW_JTAG pe_sm.v pe_shift.v pe_decoder.v jtag_sm.v fw_clock_data.v
swd: read_verilog -formal -DFORMAL -DFW_SWD pe_sm.v pe_shift.v pe_decoder.v swd_sm.v fw_clock_data.v
# Keep the program ROM as logic: as a memory, induction would leave its contents free.
hierarchy -top fw_clock_data
proc -norom
prep -top fw_clock_data

[files]
../src/pe_sm.v
../src/pe_shift.v
../src/pe_decoder.v
gen/spi_master_sm.v
gen/jtag_sm.v
gen/swd_sm.v
fw_clock_data.v
